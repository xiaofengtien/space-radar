#!/bin/bash
CURRENT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "$CURRENT_DIR/../.." && pwd)"
PROJECT_DIR="$(cd "$APP_DIR/.." && pwd)"
cd "$PROJECT_DIR"
if [ ! -f "$PROJECT_DIR/.venv/bin/SpaceRadar" ]; then
    ln -sf python "$PROJECT_DIR/.venv/bin/SpaceRadar"
fi
exec "$PROJECT_DIR/.venv/bin/SpaceRadar" "$PROJECT_DIR/main.py" "$@"
